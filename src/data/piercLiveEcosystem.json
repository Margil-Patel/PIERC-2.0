  "governors": [
    {
      "id": "1",
      "name": "Dr. Devanshu J Patel",
      "role": "President",
      "bio": "Dr. Devanshu Patel, a dynamic visionary President of Parul University, whose unflinching commitment towards education has made an impact not only in Gujarat but in all the diversified States of India, and going beyond national borders.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/Governors%2F549153Dr%20Devanshu.jpg?alt=media&token=047e0cde-8d5f-4479-b4a2-02edd875c938",
      "initials": "DJ"
    },
    {
      "id": "2",
      "name": "Dr. Parul Patel",
      "role": "Vice President (Student Affairs & General Administration) and Chair Admissions Committee, Parul University",
      "bio": "Dr. Parul Patel is a resilient administrator, Managing trustee and Vice President of Parul University whose tenderheartedness has allowed her to maintain close relations with the students while guiding them through their academic journey.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/Governors%2F768240parul%20patel.jpg?alt=media&token=6c974407-7cde-44a4-9fc6-9249902c180d",
      "initials": "PP"
    },
    {
      "id": "3",
      "name": "Dr. Geetika Patel",
      "role": "Vice President - Quality Research & Health Sciences at Parul University Medical Director, Parul University",
      "bio": "Dr Geetika Madan Patel is a proficient doctor and administrator having pursued her MBBS and MD in Community Medicine with Gold Medal from the illustrious Maharaja Sayajirao University of Baroda. Currently she is the Member of Board of Governance and Medical Director of Parul University.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/Governors%2FDr%20Geetika%20Patel%20Parul%20University.jpg?alt=media&token=43894d91-2c90-4336-94b8-fe9613699f35",
      "initials": "GP"
    },
    {
      "id": "4",
      "name": "Dr. Komal Patel",
      "role": "Vice President (Medical & Paramedical Health Sciences) & Medical Director, Parul University",
      "bio": "Dr.Komal Patel serves as Member of the Governing Body in the University’s Medical Director. She oversees smooth functioning of the University’s Ayurveda Hospita along with the Department of Obstetrics and Gynaecology in Parul Sevashram Hospital. She is actively involved developing surgical departments within the Hospital.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/Governors%2FKomal%20Patel.jpg?alt=media&token=e93361c4-9593-4bdd-b360-f72d0282d281",
      "initials": "KP"
    },
    {
      "id": "5",
      "name": "Dr. Amit Ganatra",
      "role": "Provost",
      "bio": "I am truly honoured to be a part of PU and I believe that we will be able to go a long in achieving greater heights for the University across all spheres and as long as we work together, we will surely develop the future careers of our students and the many youths across the nation”, shared Dr. Ganatra.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/Governors%2FAmit%20Ganatra%20.png?alt=media&token=f6b94688-24ac-4c70-b126-c0f214815e24",
      "initials": "AG"
    },
    {
      "id": "8",
      "name": "Prof. Manish Pandya",
      "role": "Registrar, Parul University",
      "bio": "Prof. Manish Pandya is a passion driven academician whose career and depth of technical expertise has inspired his far reaching passion for innovation in education. With his career spanning for over 19 years in the industry and in higher education, Prof. Pandya has worked in numerous professional and academic capacities which have all been collectively contributing to the development of the youth of Gujarat and the future innovators of India.",
      "image": "https://firebasestorage.googleapis.com/v0/b/edc-pierc.appspot.com/o/manish.webp?alt=media&token=5299b143-d450-437d-9eb0-64543bd7be9b",
      "initials": "MP"
    }
